// RightFit online on Cloudflare: one Worker serves the page and answers /api/... (spec/features/rightfit_online.md)
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rightfit",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": { "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
  "d1_databases": [
    // made on 20 Nov 2026 with: npx wrangler d1 create rightfit-db --location weur (Western Europe)
    { "binding": "DB", "database_name": "rightfit-db", "database_id": "d15e95b2-2269-44ce-9f51-71191b88e108" }
  ],
  // the private files: the packages' originals and RightFit's draft reviews (npx wrangler r2 bucket create rightfit-files)
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "rightfit-files" }],
  // the checks engine (web/engine/): the laptop's own Python, which only this Worker can call; on the laptop too,
  // `npm run dev` calls the engine on Cloudflare (remote), as the checks need no data of the laptop's
  "services": [{ "binding": "ENGINE", "service": "rightfit-engine", "remote": true }]
}
