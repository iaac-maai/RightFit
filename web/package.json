{
  "name": "rightfit-online",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "check": "tsc -b",
    "test": "node --test worker/*.test.ts src/*.test.ts",
    "deploy": "tsc -b && vite build && wrangler deploy",
    "db:local": "wrangler d1 execute rightfit-db --local --file=schema.sql",
    "db:remote": "wrangler d1 execute rightfit-db --remote --file=schema.sql"
  },
  "dependencies": {
    "better-auth": "1.7.17",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.67.0",
    "@cloudflare/workers-types": "5.20261101.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "wrangler": "4.156.1"
  }
}
