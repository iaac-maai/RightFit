// RightFit's checks engine: a Python Worker that only the site's Worker calls, through a service binding
// (web/wrangler.jsonc, ENGINE). No public address: workers_dev and preview URLs are off.
{
  "name": "rightfit-engine",
  "main": "build/entry.py",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["python_workers", "disable_python_external_sdk"], // the built-in workers module, with no packages to vendor
  "workers_dev": false,
  "preview_urls": false,
  "build": { "command": "python3 build.py" },
  // the booster sizing reads its catalogue and rules as files next to its code
  "rules": [{ "type": "Data", "globs": ["**/*.csv", "**/*.json"], "fallthrough": true }],
  "observability": { "enabled": true }
}
